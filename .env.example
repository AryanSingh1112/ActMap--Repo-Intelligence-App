# ---- Required everywhere (local .env.local and Vercel) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- AI (Ask, explanations, role labelling) ----
GEMINI_API_KEY=
ACTMAP_AI_MODEL=
ACTMAP_AI_FALLBACK_MODEL=

# ---- Ask ----
# Random string of 32+ characters. Signs the short-lived credential scoped to one analysis.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOOL_SECRET=

# Leave UNSET on Vercel: the agent runs inside the app.
# Local only, to use the LangGraph dev server (`npm run agent:dev`, Studio, tracing):
# AGENT_URL=http://localhost:2024
# ACTMAP_URL=http://localhost:3000   # read by agent/.env, not by Next.js

# ---- Optional: LangSmith tracing ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=actmap
